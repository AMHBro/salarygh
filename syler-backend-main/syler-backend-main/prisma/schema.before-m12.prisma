  name             String?             @db.VarChar(200)
  branch_id        String?             @db.Uuid
  assigned_user_id String?             @db.Uuid
  status           cashbox_status_enum @default(CLOSED)
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
  updated_at       DateTime            @default(now()) @db.Timestamptz(6)
  cashbox_sessions cashbox_sessions[]
  users            users?              @relation(fields: [assigned_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branches         branches?           @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
