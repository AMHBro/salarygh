  @@index([reference_type, reference_id], map: "idx_movements_ref")
  @@index([variant_id, created_at(sort: Desc)], map: "idx_movements_variant")
  @@index([warehouse_id, created_at(sort: Desc)], map: "idx_movements_warehouse")
