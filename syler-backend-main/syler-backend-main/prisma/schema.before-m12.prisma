generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model accounts_ledger {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_type     account_type_enum
  account_id       String            @db.Uuid
  total_debit      Decimal           @default(0) @db.Decimal(15, 2)
  total_credit     Decimal           @default(0) @db.Decimal(15, 2)
  balance          Decimal?          @default(dbgenerated("(total_debit - total_credit)")) @db.Decimal(15, 2)
  last_transaction DateTime?         @db.Timestamptz(6)

  @@unique([account_type, account_id])
  @@index([account_type, account_id], map: "idx_accounts_entity")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model branches {
  id                              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id                      String              @db.Uuid
  name                            String              @db.VarChar(200)
  address                         String?
  phone                           String?             @db.VarChar(20)
  manager_id                      String?             @db.Uuid
  created_at                      DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime            @default(now()) @db.Timestamptz(6)
  code                            String              @unique @db.VarChar(50)
  created_by                      String?             @db.Uuid
  notes                           String?
  rejection_reason                String?
  status                          org_status_enum     @default(DRAFT)
  type                            branch_type_enum    @default(STANDARD)
  companies                       companies           @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator                         users?              @relation("BranchCreator", fields: [created_by], references: [id])
  manager                         users?              @relation("BranchManager", fields: [manager_id], references: [id])
  cashboxes                       cashboxes[]
  device_sync_state               device_sync_state[]
  representatives                 representatives[]
  users_users_branch_idTobranches users[]             @relation("users_branch_idTobranches")
  warehouses                      warehouses[]

  @@index([status])
  @@index([type])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cashbox_sessions {
  id                                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cashbox_id                              String              @db.Uuid
  opened_by                               String              @db.Uuid
  closed_by                               String?             @db.Uuid
  opened_at                               DateTime            @default(now()) @db.Timestamptz(6)
  closed_at                               DateTime?           @db.Timestamptz(6)
  opening_balance                         Decimal             @default(0) @db.Decimal(15, 2)
  closing_balance                         Decimal             @default(0) @db.Decimal(15, 2)
  total_sales                             Decimal             @default(0) @db.Decimal(15, 2)
  total_returns                           Decimal             @default(0) @db.Decimal(15, 2)
  status                                  cashbox_status_enum @default(OPEN)
  cashboxes                               cashboxes           @relation(fields: [cashbox_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_cashbox_sessions_closed_byTousers users?              @relation("cashbox_sessions_closed_byTousers", fields: [closed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_cashbox_sessions_opened_byTousers users               @relation("cashbox_sessions_opened_byTousers", fields: [opened_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sales_invoices                          sales_invoices[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cashboxes {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
